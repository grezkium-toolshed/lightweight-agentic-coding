{
  "version": 1,
  "providers": [
    {
      "id": "local-cluster",
      "label": "Local llama.cpp Cluster",
      "env_var": "AI_CLUSTER_LOCAL_RUNTIME",
      "docs_path": "docs/providers/README.md",
      "risk_level": "low",
      "models": [
        { "id": "local-cluster/qwen3.6-27b-q4", "risk_level": "low" },
        { "id": "local-cluster/gemma-4-31b-q4", "risk_level": "low" }
      ]
    },
    {
      "id": "openrouter",
      "label": "OpenRouter Free Tier",
      "env_var": "OPENROUTER_API_KEY",
      "docs_path": "docs/providers/OPENROUTER_FREE.md",
      "risk_level": "high",
      "models": [
        { "id": "openrouter/qwen/qwen3-coder:480b-free", "risk_level": "high" },
        { "id": "openrouter/openai/gpt-4o-mini:free", "risk_level": "high" }
      ]
    },
    {
      "id": "nvidia-nim",
      "label": "NVIDIA NIM",
      "env_var": "NVIDIA_API_KEY",
      "docs_path": "docs/providers/NVIDIA_NIM.md",
      "risk_level": "medium",
      "models": [
        { "id": "nvidia-nim/qwen/qwen3-coder-480b-a35b-instruct", "risk_level": "medium" }
      ]
    },
    {
      "id": "opencode-go",
      "label": "OpenCode Go",
      "env_var": "OPENCODE_GO_API_KEY",
      "docs_path": "docs/providers/OPENCODE_GO.md",
      "risk_level": "low",
      "models": [
        { "id": "opencode-go/qwen3.6-plus", "risk_level": "low" },
        { "id": "opencode-go/qwen3.5-plus", "risk_level": "low" }
      ]
    },
    {
      "id": "anthropic",
      "label": "Anthropic API",
      "env_var": "ANTHROPIC_API_KEY",
      "docs_path": "docs/providers/ANTHROPIC_API.md",
      "risk_level": "low",
      "models": [
        { "id": "anthropic/claude-sonnet-4-6", "risk_level": "low" },
        { "id": "anthropic/claude-opus-4-7", "risk_level": "low" }
      ]
    }
  ]
}
