{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-cluster/qwen3.6-27b-q4",
  "small_model": "local-cluster/qwen3.6-27b-q3",
  // Dynamic Context Pruning — supplemental model-guided compression and automatic cleanup.
  // Project config: .opencode/dcp.jsonc
  // Upstream: https://github.com/Opencode-DCP/opencode-dynamic-context-pruning
  "plugin": [
    "@tarquinen/opencode-dcp@3.1.9",
    // Ponytail — laziness ruleset injected into every turn, plus /ponytail lite|full|ultra|off
    // commands and the review/audit/debt skills. MIT. Fetched from npm on first use (network).
    // Upstream: https://github.com/DietrichGebert/ponytail
    // Per-session opt-out: PONYTAIL_DEFAULT_MODE=off (or /ponytail off). See THIRD_PARTY_NOTICES.md.
    "@dietrichgebert/ponytail@4.9.0"
  ],
  "provider": {
    "local-cluster": {
      "name": "Local llama.cpp Cluster",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen3.5-4b-q4": {
          "limit": {
            "context": 262144,
            "output": 4096
          }
        },
        "qwen3.6-27b-q3": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        // Qwen 3.6 27B UD-IQ3_XXS (12.2 GB) — the honest 16 GB 27B-dense quant.
        "qwen3.6-27b-iq3xxs": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.6-27b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.6-35b-a3b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.6-27b-mtp-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.6-35b-a3b-mtp-q6": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        // Qwen 3.8-27B — open weights expected ~2026-08-10 (alongside Qwen3.8-Max 2.4T).
        // Slots are live so configs render before the drop; keep in sync with docs/models/QWEN38_READY.md.
        // Until GGUFs land, `lac models sync` has no catalog entry for these and will skip them.
        "qwen3.8-27b-q3": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.8-27b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.8-27b-q6": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5-9b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5-9b-q6": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5-9b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5-122b-a10b": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "minimax-m2.7": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "gemma-4-26b-a4b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-12b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-12b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        // Gemma 4 12B QAT (Google-official, near-lossless, ~6.4 GB) — the strongest 8 GB model.
        "gemma-4-12b-qat": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-31b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-31b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-e4b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-31b-bf16": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "ds4": {
      "name": "DwarfStar ds4 local",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (ds4 local)",
          "limit": {
            "context": 262144,
            "output": 384000
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "dsv4-local",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "nvidia-nim": {
      "name": "NVIDIA NIM Free or Trial",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "deepseek-ai/deepseek-v3.2": {},
        "qwen/qwen3-coder-480b-a35b-instruct": {},
        "qwen/qwen2.5-coder-32b-instruct": {},
        "openai/gpt-oss-120b": {},
        "meta/llama-3.3-70b-instruct": {},
        "nvidia/nemotron-3-nano-30b-a3b": {},
        "moonshotai/kimi-k2.5": {},
        "minimaxai/minimax-m2.1": {},
        "deepseek-ai/deepseek-v3.1-terminus": {},
        "qwen/qwen3-235b-a22b": {},
        "mistralai/devstral-2-123b-instruct-2512": {}
      },
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    // OpenRouter prefers live catalog data after `./bin/lac provider verify openrouter --refresh-catalog`.
    // These starter defaults keep clean-clone rendering usable before the first refresh.
    // Keep this block aligned with catalog/providers.json and `./bin/lac provider models openrouter`.
    "openrouter": {
      "name": "OpenRouter Free Tier",
      "npm": "@ai-sdk/openai-compatible",
      // Live free-tier catalog as of 2026-08-04; free models rotate — refresh with:
      //   lac catalog sync-free && lac profile apply openrouter
      "models": {
        "google/gemma-4-26b-a4b-it:free": {},
        "google/gemma-4-31b-it:free": {},
        "nvidia/nemotron-3-nano-30b-a3b:free": {},
        "nvidia/nemotron-3-super-120b-a12b:free": {},
        "nvidia/nemotron-nano-9b-v2:free": {},
        "openai/gpt-oss-20b:free": {},
        "cohere/north-mini-code:free": {},
        "inclusionai/ling-3.0-flash:free": {},
        "poolside/laguna-s-2.1:free": {},
        "poolside/laguna-xs-2.1:free": {}
      },
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "npm": "@ai-sdk/openai-compatible",
      // OpenAI-compatible Go models as of 2026-08-04 (docs: opencode.ai/docs/go/).
      // Go also hosts qwen3.6-plus / qwen3.7-plus / qwen3.8-max and minimax-m3/m2.7/m2.5,
      // but those use the Anthropic /v1/messages endpoint and only work via OpenCode's
      // /connect flow — they are intentionally not listed here.
      "models": {
        "grok-4.5": {},
        "glm-5.2": {},
        "glm-5.1": {},
        "kimi-k3": {},
        "kimi-k2.7-code": {},
        "kimi-k2.6": {},
        "deepseek-v4-pro": {},
        "deepseek-v4-flash": {},
        "mimo-v2.5-pro": {},
        "mimo-v2.5": {},
        "hy3": {}
      },
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "anthropic": {
      "name": "Anthropic API",
      "npm": "@ai-sdk/anthropic",
      "models": {
        "claude-opus-4-7": {},
        "claude-sonnet-4-6": {},
        "claude-haiku-4-5-20251001": {}
      },
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    }
  },
  "mcp": {
    // GitHub API — PRs, issues, CI checks, code search. Requires `npx` + `GITHUB_TOKEN`.
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/github"],
      // Requires `npx -y @modelcontextprotocol/github` to install itself on first use.
      // Set enabled: true and export GITHUB_TOKEN to activate.
      "enabled": false,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },
  "command": {
    // Run lac doctor to validate the local setup
    "doctor": {
      "template": "Run `./bin/lac doctor` to validate the lac setup. Report any issues and suggest fixes.",
      "description": "Validate lac setup",
      "agent": "build"
    },
    // Check runtime health through the effective network record, never a fixed port
    "health": {
      "template": "Run `./bin/lac runtime status --json` first. Use its effective `url` and `runtime`: query `<url>/health` for llama.cpp or `<url>/v1/models` for oMLX/ds4. Report the configured endpoint and status; do not assume a port.",
      "description": "Check runtime health",
      "agent": "build"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".sisyphus/**",
      "state/**",
      ".opencode/render-manifest.json",
      "models/**",
      "docs/free-coding-models.json",
      "**/*.gguf",
      "**/*.bak",
      "**/*.backup.*"
    ]
  },
  "instructions": [
    "AGENTS.md",
    "docs/rules/*.md"
  ],
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "architecture-reviewer": "allow",
          "release-reviewer": "allow",
          "reality-checker": "allow",
          "documentation-generator": "allow",
          "research-synthesizer": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "architecture-reviewer": "allow",
          "release-reviewer": "allow",
          "reality-checker": "allow",
          "research-synthesizer": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "curl http://127.0.0.1:*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}
