{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-cluster/qwen3.6-27b-q4",
  "small_model": "local-cluster/qwen3.6-27b-q3",
  // Dynamic Context Pruning — auto-compresses stale context for local models.
  // Project config: .opencode/dcp.jsonc
  // Upstream: https://github.com/Opencode-DCP/opencode-dynamic-context-pruning
  "plugin": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "provider": {
    "local-cluster": {
      "name": "Local llama.cpp Cluster",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen3.5-4b-q4": {
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "qwen3.6-27b-q3": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.6-27b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.6-35b-a3b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.6-27b-mtp-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.6-35b-a3b-mtp-q6": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5-9b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5-122b-a10b": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "minimax-m2.7": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "gemma-4-26b-a4b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-12b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-12b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-31b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-31b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-e4b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-31b-bf16": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "ds4": {
      "name": "DwarfStar ds4 local",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (ds4 local)",
          "limit": {
            "context": 100000,
            "output": 384000
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "dsv4-local",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "nvidia-nim": {
      "name": "NVIDIA NIM Free or Trial",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "deepseek-ai/deepseek-v3.2": {},
        "qwen/qwen3-coder-480b-a35b-instruct": {},
        "qwen/qwen2.5-coder-32b-instruct": {},
        "openai/gpt-oss-120b": {},
        "meta/llama-3.3-70b-instruct": {},
        "nvidia/nemotron-3-nano-30b-a3b": {},
        "moonshotai/kimi-k2.5": {},
        "minimaxai/minimax-m2.1": {},
        "deepseek-ai/deepseek-v3.1-terminus": {},
        "qwen/qwen3-235b-a22b": {},
        "mistralai/devstral-2-123b-instruct-2512": {}
      },
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    // OpenRouter prefers live catalog data after `./bin/lac provider verify openrouter --refresh-catalog`.
    // These starter defaults keep clean-clone rendering usable before the first refresh.
    // Keep this block aligned with catalog/providers.json and `./bin/lac provider models openrouter`.
    "openrouter": {
      "name": "OpenRouter Free Tier",
      "npm": "@ai-sdk/openai-compatible",
      // Starter defaults are replaced by catalog-backed entries after refresh.
      "models": {
        "qwen/qwen3-coder:480b-free": {},
        "mistralai/devstral-2-free": {},
        "stepfun/step-3.5-flash:free": {},
        "openai/gpt-oss-120b:free": {},
        "openai/gpt-oss-20b:free": {},
        "nvidia/nemotron-3-nano-30b-a3b:free": {},
        "openai/gpt-4o-mini:free": {},
        "google/gemini-2.0-flash-exp:free": {},
        "meta-llama/llama-3.3-70b-instruct:free": {},
        "z-ai/glm-4.5-air:free": {},
        "qwen/qwen3-next-80b-a3b-instruct:free": {}
      },
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "glm-5.1": {},
        "glm-5": {},
        "kimi-k2.6": {},
        "kimi-k2.5": {},
        "mimo-v2.5-pro": {},
        "mimo-v2.5": {},
        "mimo-v2-pro": {},
        "mimo-v2-omni": {},
        "qwen3.6-plus": {},
        "qwen3.5-plus": {},
        "minimax-m2.7": {},
        "minimax-m2.5": {}
      },
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "anthropic": {
      "name": "Anthropic API",
      "npm": "@ai-sdk/anthropic",
      "models": {
        "claude-opus-4-7": {},
        "claude-sonnet-4-6": {},
        "claude-haiku-4-5-20251001": {}
      },
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    }
  },
  "mcp": {
    // GitHub API — PRs, issues, CI checks, code search. Requires `npx` + `GITHUB_TOKEN`.
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/github"],
      // Requires `npx -y @modelcontextprotocol/github` to install itself on first use.
      // Set enabled: true and export GITHUB_TOKEN to activate.
      "enabled": false,
      "environment": {
        "GITHUB_TOKEN": "{env:GITHUB_TOKEN}"
      }
    }
  },
  "command": {
    // Run lac doctor to validate the local setup
    "doctor": {
      "template": "Run `./bin/lac doctor` to validate the lac setup. Report any issues and suggest fixes.",
      "description": "Validate lac setup",
      "agent": "build"
    },
    // Check runtime health on the active port (llama.cpp 8080, oMLX/ds4 8000)
    "health": {
      "template": "Check if the local runtime is healthy. Try `curl -s http://127.0.0.1:8080/health` first (llama.cpp default). If that fails, try `curl -s http://127.0.0.1:8000/v1/models` (oMLX or ds4 default). Report which port responded and the status. If neither responds, suggest running `./bin/lac runtime status` to see which runtime is configured.",
      "description": "Check runtime health",
      "agent": "build"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".sisyphus/**",
      "state/**",
      ".opencode/render-manifest.json",
      "models/**",
      "docs/free-coding-models.json",
      "**/*.gguf",
      "**/*.bak",
      "**/*.backup.*"
    ]
  },
  "instructions": [
    "AGENTS.md",
    "docs/rules/*.md"
  ],
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "architecture-reviewer": "allow",
          "release-reviewer": "allow",
          "reality-checker": "allow",
          "documentation-generator": "allow",
          "research-synthesizer": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "architecture-reviewer": "allow",
          "release-reviewer": "allow",
          "reality-checker": "allow",
          "research-synthesizer": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "curl http://127.0.0.1:*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}
