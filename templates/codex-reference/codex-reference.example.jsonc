{
  "$schema": "https://opencode.ai/config.json",
  "_comment": "Codex reference adapter — generated by ./bin/lac client render codex-reference",
  "model": "codex-auth/gpt-5-codex",
  "provider": {
    "codex-auth": {
      "name": "Codex via ChatGPT Subscription",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "gpt-5-codex": {}
      },
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  }
}
