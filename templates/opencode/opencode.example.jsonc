{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-cluster/qwen3.5-27b-q4",
  "provider": {
    "local-cluster": {
      "name": "Local llama.cpp Cluster",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen3.5-9b-q4": {
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.5-27b-q4": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "qwen3.5-35b-a3b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5-122b-a10b": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "qwen3-coder-next-80b": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "minimax-m2.5": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "nomic-embed-text-v1.5": {
          "limit": {
            "context": 2048,
            "output": 512
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": 600000
      }
    }
  },
  "permission": {
    "bash": {
      "git *": "ask",
      "rm *": "ask",
      "docker *": "ask",
      "*": "allow"
    }
  }
}
