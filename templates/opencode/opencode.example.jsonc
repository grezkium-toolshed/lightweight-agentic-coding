{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-cluster/qwen3.6-35b-a3b-q8",
  "small_model": "local-cluster/qwen3.6-27b-q4",
  "plugin": [
    "opencode-antigravity-auth"
  ],
  "provider": {
    // This example is intentionally minimal. Run `./bin/lac profile apply <profile>` for a full config with all models.
    "local-cluster": {
      "name": "Local llama.cpp Cluster",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen3.6-27b-q3": { "limit": { "context": 65536, "output": 8192 } },
        "qwen3.6-27b-q4": { "limit": { "context": 131072, "output": 12288 } },
        "qwen3.6-35b-a3b-q8": { "limit": { "context": 262144, "output": 16384 } },
        "qwen3.5-122b-a10b": { "limit": { "context": 131072, "output": 12288 } },
        "qwen3.5-4b-q4": { "limit": { "context": 8192, "output": 4096 } },
        "qwen3.6-27b-mtp-q4": { "limit": { "context": 131072, "output": 12288 } },
        "qwen3.6-35b-a3b-mtp-q6": { "limit": { "context": 262144, "output": 16384 } },
        "minimax-m2.5": { "limit": { "context": 131072, "output": 12288 } },
        "nomic-embed-text-v1.5": { "limit": { "context": 2048, "output": 512 } },
        "qwen3.5-9b-q4": { "limit": { "context": 32768, "output": 8192 } },
        "minimax-m2.7": { "limit": { "context": 131072, "output": 12288 } },
        "gemma-4-26b-a4b-q4": { "limit": { "context": 262144, "output": 16384 } },
        "gemma-4-12b-q8": { "limit": { "context": 262144, "output": 16384 } },
        "gemma-4-12b-q4": { "limit": { "context": 262144, "output": 16384 } },
        "gemma-4-31b-q4": { "limit": { "context": 262144, "output": 16384 } },
        "gemma-4-31b-q8": { "limit": { "context": 262144, "output": 16384 } },
        "gemma-4-e4b-q8": { "limit": { "context": 131072, "output": 8192 } },
        "gemma-4-31b-bf16": { "limit": { "context": 262144, "output": 16384 } }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "antigravity": {
      "name": "Antigravity Cloud",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "gpt-oss-120b": { "limit": { "context": 131072, "output": 16384 } },
        "gpt-oss-20b": { "limit": { "context": 131072, "output": 12288 } },
        "qwen3-coder-480b": { "limit": { "context": 262144, "output": 16384 } },
        "deepseek-v3.2": { "limit": { "context": 131072, "output": 12288 } }
      },
      "options": {
        "baseURL": "https://api.antigravity.ai/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "z-ai": {
      "name": "Z.AI Cloud",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "zai/glm-5": { "limit": { "context": 131072, "output": 12288 } },
        "zai/glm-4.7": { "limit": { "context": 200000, "output": 12288 } },
        "zai/glm-4.5-air": { "limit": { "context": 131072, "output": 12288 } }
      },
      "options": {
        "baseURL": "https://open.z.ai/api/paas/v4",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "nvidia-nim": {
      "name": "NVIDIA NIM Free or Trial",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "deepseek-ai/deepseek-v3.2": { "limit": { "context": 128000, "output": 12288 } },
        "qwen/qwen3-coder-480b-a35b-instruct": { "limit": { "context": 256000, "output": 16384 } },
        "qwen/qwen2.5-coder-32b-instruct": { "limit": { "context": 32000, "output": 8192 } },
        "openai/gpt-oss-120b": { "limit": { "context": 128000, "output": 12288 } },
        "meta/llama-3.3-70b-instruct": { "limit": { "context": 128000, "output": 8192 } }
      },
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "openrouter": {
      "name": "OpenRouter Free Tier",
      "npm": "@ai-sdk/openai-compatible",
      // Starter defaults are replaced by catalog-backed entries after refresh.
      "models": {
        "qwen/qwen3-coder:480b-free": { "limit": { "context": 262144, "output": 16384 } },
        "stepfun/step-3.5-flash:free": { "limit": { "context": 262144, "output": 16384 } },
        "openai/gpt-oss-120b:free": { "limit": { "context": 131072, "output": 12288 } },
        "openai/gpt-oss-20b:free": { "limit": { "context": 131072, "output": 8192 } },
        "nvidia/nemotron-3-nano-30b-a3b:free": { "limit": { "context": 131072, "output": 8192 } }
      },
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    // Stubs — add your API key env var to use these providers.
    "opencode-zen": {
      "name": "OpenCode Zen",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "glm-4.7": { "limit": { "context": 200000, "output": 12288 } },
        "claude-sonnet-4-6": { "limit": { "context": 200000, "output": 12288 } },
        "gpt-5-codex": { "limit": { "context": 200000, "output": 12288 } }
      },
      "options": {
        "baseURL": "https://api.opencode.ai/zen/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "glm-5.1": { "limit": { "context": 200000, "output": 12288 } },
        "glm-5": { "limit": { "context": 200000, "output": 12288 } },
        "qwen3.6-plus": { "limit": { "context": 262144, "output": 16384 } },
        "minimax-m2.7": { "limit": { "context": 131072, "output": 12288 } }
      },
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "codex-auth": {
      "name": "Codex (ChatGPT Subscription)",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "gpt-5-codex": { "limit": { "context": 200000, "output": 16384 } },
        "gpt-5": { "limit": { "context": 200000, "output": 16384 } }
      },
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "anthropic": {
      "name": "Anthropic API",
      "npm": "@ai-sdk/anthropic",
      "models": {
        "claude-opus-4-7": { "limit": { "context": 200000, "output": 16384 } },
        "claude-sonnet-4-6": { "limit": { "context": 200000, "output": 16384 } },
        "claude-haiku-4-5-20251001": { "limit": { "context": 200000, "output": 16384 } }
      },
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [".git/**", ".sisyphus/**", "models/**", "runtime-config/logs/**", "**/*.gguf"]
  },
  "instructions": ["AGENTS.md", "docs/rules/*.md", "docs/release/*.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "curl http://127.0.0.1:*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}
