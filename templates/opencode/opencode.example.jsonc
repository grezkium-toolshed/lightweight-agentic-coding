{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-cluster/qwen3.6-35b-a3b-q8",
  "small_model": "local-cluster/qwen3.6-27b-q4",
  "provider": {
    // Minimal example. Run `lac profile apply <profile>` for the complete generated config.
    "local-cluster": {
      "name": "Local llama.cpp Cluster",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen3.6-27b-q4": { "limit": { "context": 131072, "output": 12288 } },
        "qwen3.6-35b-a3b-q8": { "limit": { "context": 262144, "output": 16384 } },
        "qwen3.5-4b-q4": { "limit": { "context": 8192, "output": 4096 } }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "openrouter": {
      "name": "OpenRouter Free Tier",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "openai/gpt-oss-120b:free": { "limit": { "context": 131072, "output": 12288 } }
      },
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "nvidia-nim": {
      "name": "NVIDIA NIM Free or Trial",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "openai/gpt-oss-120b": { "limit": { "context": 128000, "output": 12288 } }
      },
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen3.6-plus": { "limit": { "context": 262144, "output": 16384 } }
      },
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "anthropic": {
      "name": "Anthropic API",
      "npm": "@ai-sdk/anthropic",
      "models": {
        "claude-sonnet-4-6": { "limit": { "context": 200000, "output": 16384 } }
      },
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [".git/**", "models/**", "runtime-config/logs/**", "**/*.gguf"]
  },
  "instructions": ["AGENTS.md", "docs/rules/*.md"]
}
