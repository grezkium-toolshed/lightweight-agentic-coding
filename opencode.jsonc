        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "opencode-zen": {
      "name": "OpenCode Zen",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "glm-4.7": {
          "limit": {
            "context": 200000,
            "output": 12288
          }
        },
        "claude-sonnet-4-6": {
          "limit": {
            "context": 200000,
            "output": 12288
          }
        },
        "gpt-5-codex": {
          "limit": {
            "context": 200000,
            "output": 12288
          }
        }
      },
      "options": {
        "baseURL": "https://api.opencode.ai/zen/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "glm-4.7": {
          "limit": {
            "context": 200000,
            "output": 12288
