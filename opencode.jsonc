            "context": 128000,
            "output": 8192
          }
        },
        "moonshotai/kimi-k2.5": {
          "limit": {
            "context": 128000,
            "output": 12288
          }
        },
        "minimaxai/minimax-m2.1": {
          "limit": {
            "context": 200000,
            "output": 12288
          }
        },
        "deepseek-ai/deepseek-v3.1-terminus": {
          "limit": {
            "context": 128000,
