      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "openrouter": {
      "name": "OpenRouter Free Tier",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen/qwen3-coder:480b-free": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "mistralai/devstral-2-free": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "stepfun/step-3.5-flash:free": {
