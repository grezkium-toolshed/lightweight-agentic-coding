{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-cluster/qwen3-14b-q4",
  "small_model": "local-cluster/qwen3-8b-q4",
  "plugin": [
    "opencode-antigravity-auth"
  ],
  "provider": {
    "local-cluster": {
      "name": "Local llama.cpp Cluster",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "qwen3-8b-q4": {
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3-14b-q4": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "qwen3-30b-a3b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "qwen3.5-122b-a10b": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "qwen3-coder-next-80b": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "minimax-m2.7": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "nomic-embed-text-v1.5": {
          "limit": {
            "context": 2048,
            "output": 512
          }
        },
        "gemma-4-26b-a4b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-31b-q4": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-31b-q8": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "gemma-4-e4b-q8": {
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "gemma-4-31b-bf16": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      },
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "antigravity": {
      "name": "Antigravity Cloud",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "gpt-oss-120b": {
          "limit": {
            "context": 131072,
            "output": 16384
          }
        },
        "gpt-oss-20b": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "qwen3-coder-480b": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        },
        "deepseek-v3.2": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        }
      },
      "options": {
        "baseURL": "https://api.antigravity.ai/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "z-ai": {
      "name": "Z.AI Cloud",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "zai/glm-5": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "zai/glm-4.7": {
          "limit": {
            "context": 200000,
            "output": 12288
          }
        },
        "zai/glm-4.5": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "zai/glm-4.5-air": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "zai/glm-4.6": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        }
      },
      "options": {
        "baseURL": "https://open.z.ai/api/paas/v4",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "nvidia-nim": {
      "name": "NVIDIA NIM Free or Trial",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "deepseek-ai/deepseek-v3.2": {
          "limit": {
            "context": 128000,
            "output": 12288
          }
        },
        "qwen/qwen3-coder-480b-a35b-instruct": {
          "limit": {
            "context": 256000,
            "output": 16384
