            "context": 131072,
            "output": 8192
          }
        },
        "google/gemini-2.0-flash-exp:free": {
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "meta-llama/llama-3.3-70b-instruct:free": {
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "z-ai/glm-4.5-air:free": {
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen/qwen3-next-80b-a3b-instruct:free": {
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
