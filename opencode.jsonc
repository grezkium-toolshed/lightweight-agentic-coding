        "gpt-oss-120b": {
          "limit": {
            "context": 131072,
            "output": 12288
          }
        },
        "qwen3-coder": {
          "limit": {
            "context": 262144,
            "output": 16384
          }
        }
      },
      "options": {
        "baseURL": "https://api.opencode.ai/go/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "codex-auth": {
      "name": "Codex (ChatGPT Subscription)",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "gpt-5-codex": {
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "gpt-5": {
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      },
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    },
    "anthropic": {
      "name": "Anthropic API",
      "npm": "@ai-sdk/anthropic",
      "models": {
        "claude-opus-4-7": {
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-sonnet-4-6": {
          "limit": {
            "context": 200000,
            "output": 16384
          }
        },
        "claude-haiku-4-5-20251001": {
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      },
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      ".sisyphus/**",
      "state/**",
      ".opencode/render-manifest.json",
      "models/**",
      "docs/free-coding-models.json",
      "**/*.gguf",
      "**/*.bak",
      "**/*.backup.*"
    ]
  },
  "instructions": [
    "AGENTS.md",
    "docs/rules/*.md",
    "docs/release/*.md"
  ],
  "agent": {
    "build": {
      "permission": {
        "task": {
          "*": "deny",
          "architecture-reviewer": "allow",
          "release-reviewer": "allow",
          "reality-checker": "allow",
          "documentation-generator": "allow",
          "research-synthesizer": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "permission": {
        "task": {
          "*": "deny",
          "architecture-reviewer": "allow",
          "release-reviewer": "allow",
          "reality-checker": "allow",
          "research-synthesizer": "allow"
        },
        "skill": {
          "*": "allow"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "find *": "allow",
      "rg *": "allow",
      "sed *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git rev-parse*": "allow",
      "curl http://127.0.0.1:*": "allow"
    },
    "skill": {
      "*": "allow"
    }
  }
}
